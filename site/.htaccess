# =====================================================================
# Ce dossier est celui qui MONTE sur le serveur, tel quel (sauf uploads/,
# qui reste en place). Il ne contient donc ni tests, ni documentation, ni
# schéma SQL, ni .env : tout cela est à la racine du dépôt, hors de ce
# dossier, et rien n'a plus à être bloqué ici. tests/cas/structure_test.php
# le vérifie : un fichier de plus dans site/, c'est un fichier de plus en
# ligne.
#
# Reste à protéger ce qui monte réellement : les fichiers « point »
# (.htaccess, .user.ini, et un .env s'il se glissait là) et includes/.
# Les pages PHP, elles, gèrent leur propre protection (voir
# exiger_connexion() dans includes/fonctions.php).
# =====================================================================

# Tout fichier « point » : .htaccess, .user.ini, .env… C'est elle qui
# répond (403), même en présence de la règle suivante : dans un
# .htaccess, Apache applique « Require » AVANT les RedirectMatch. Elle
# tient aussi sans mod_alias.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Les fichiers inclus par PHP (require_once), jamais demandés par un
# navigateur. « includes/.htaccess » les bloque déjà : cette règle double
# la sienne, pour le cas d'un dossier envoyé sans ses fichiers cachés.
# Un 404 plutôt qu'un 403 : « interdit » confirme que le fichier existe.
<IfModule mod_alias.c>
    RedirectMatch 404 (?i)/includes(/|$)
</IfModule>

# Pas de listing de dossier, et pas de négociation de contenu : sans
# « -MultiViews », /api peut être servi par api.php, ce qui contourne
# les règles écrites sur les noms de fichiers.
Options -Indexes -MultiViews

# Redirige tout accès en http:// vers https:// (le cookie de session n'est
# marqué "secure" — donc protégé — que sur une connexion chiffrée).
# localhost/127.0.0.1 exclus : pas de HTTPS en développement local (XAMPP).
#
# La condition teste aussi X-Forwarded-Proto : chez OVH, TLS est terminé
# en amont et la variable HTTPS d'Apache reste vide même sur une
# connexion chiffrée. Sans ce test, on boucle en redirections infinies.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP_HOST} !^localhost(:\d+)?$ [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:\d+)?$
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
    # N'annonce pas la version de PHP utilisée par le serveur
    Header always unset X-Powered-By
    # HSTS : une fois qu'un navigateur a vu ce site en HTTPS, il refuse tout
    # retour en HTTP pendant 6 mois, même via un lien http:// tapé à la main.
    # includeSubDomains : sans lui, un sous-domaine oublié servi en clair
    # reste une porte ouverte pour intercepter les cookies du domaine.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# =====================================================================
# Performance
# =====================================================================

# Compression : le HTML, le CSS et le JavaScript perdent 70 à 80 % de
# leur poids. C'est le réglage avec le meilleur rapport effort/gain de
# tout ce fichier. (Les images et les polices sont déjà compressées :
# les repasser à la moulinette coûterait du CPU pour rien.)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    # « text/javascript » est le type que sert Apache 2.4 récent pour les
    # .js — sans cette ligne, le JavaScript partait NON compressé, et la
    # seule mention de « application/javascript » ne servait à rien.
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cache navigateur. css/ et js/ sont servis avec l'empreinte du fichier
# dans l'URL (voir la fonction actif() dans includes/fonctions.php) :
# une modification change l'URL, donc un cache d'un an ne risque jamais
# de servir une version périmée.
# Les pages PHP, elles, envoient « Cache-Control: no-store » : elles
# dépendent du compte connecté et ne doivent jamais être mises en cache.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                      "access plus 1 hour"
    ExpiresByType text/css              "access plus 1 year"
    # Même raison que pour la compression : sans « text/javascript », les
    # .js retombaient sur ExpiresDefault (1 heure) et tout le travail
    # autour de ASSETS_VERSION ne servait à rien.
    ExpiresByType text/javascript       "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/jpeg            "access plus 1 year"
    ExpiresByType image/png             "access plus 1 year"
    ExpiresByType image/gif             "access plus 1 year"
    ExpiresByType image/webp            "access plus 1 year"
    ExpiresByType image/svg+xml         "access plus 1 year"
    ExpiresByType text/html             "access plus 0 seconds"
</IfModule>
