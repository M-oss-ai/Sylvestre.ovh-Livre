# ===================================================================================
# Copiez ce fichier en « .env » et remplacez les valeurs.
# « .env » n'est jamais versionné (.gitignore).
#
# Où le mettre : AU-DESSUS du dossier que sert le web (config.php le cherche
# là en premier). En production, au-dessus de www/ : hors de portée du
# serveur web même si un .htaccess venait à être ignoré. En local, à la
# racine du dépôt, à côté de site/ : un envoi de site/ ne l'emporte jamais.
#
# Tout est expliqué en détail dans le README. Ici, seulement ce qui
# coûte cher si on se trompe.
# ===================================================================================

# --- Site --------------------------------------------------------------------------
# E-mail admin affiché aux utilisateurs
# APP_URL : sans barre oblique finale. Elle fabrique les liens des e-mails
APP_URL=https://votredomaine.fr
ADMIN_EMAIL=admin@exemple.com

# --- Connextion Base de Données ---------------------------------------------------
DB_HOST=localhost
DB_NAME=Livre
DB_USER=root
DB_PASSWORD=motdepasse

# --- Cache des fichiers js/ et css/ ------------------------------------------------
# À INCRÉMENTER à chaque déploiement qui touche js/ ou css/.
ASSETS_VERSION=1

# --- Quotas ------------------------------------------------------------------------
MAX_UTILISATEURS=100
MAX_SERIES_PAR_UTILISATEUR=150
MAX_APPAREILS=30
QUOTA_BASE_MO=200

# 0 : pas de pages, toutes les séries sur une seule page.
SERIES_PAGES_MAX=30

# --- Sessions ----------------------------------------------------------------------
# Durée à « 0 » : le cookie de session meurt avec le navigateur.
# Durée à « 31536000 » : 1 an, « 3600 » : 1 heure
SESSION_DUREE=0
REMEMBER_DUREE_VIP=31536000
CONFIRMATION_DUREE=300
ADMIN_SUPPRESSION_DUREE=3600

# --- Clés d'accès (passkeys) -----------------------------------------------------
# Nombre de clés par compte (1 à 50) et validité, en secondes, du défi
# envoyé au navigateur (60 à 900). Inutile de les écrire : ce sont les défauts.
CLE_ACCES_MAX=10
CLE_ACCES_DEFI_DUREE=300

# --- Connexion avec Google ---------------------------------------------------------
# Vides : pas de bouton « Continuer avec Google ».
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Mots de passe -----------------------------------------------------------------
# MDP_MIN : longueur minimale, de 1 à 200 caractères (espaces non comptés). Sous 8, la protection s'affaiblit.
# MDP_MAJ, MDP_MINUSCULE, MDP_CHIFFRE, MDP_SPE : 1 = la classe est exigée, 0 = non.
#   Seul « 0 » desserre : une ligne vide ou une faute de frappe laisse la règle en place.
# Modifiables aussi depuis la page d'administration (groupe « Mots de passe »), qui prime sur ce fichier.
# MDP_MAX est une borne technique (coût du hachage) : il reste ici, et dépasse toujours MDP_MIN.
MDP_MIN=8
MDP_MAJ=1
MDP_MINUSCULE=1
MDP_CHIFFRE=1
MDP_SPE=1
MDP_MAX=200

# --- E-mails SMTP ------------------------------------------------------------------
# Boîte OVH : manager.ovh.com > votre domaine > Emails.
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=587
SMTP_USER=noreply@exemple.com
SMTP_PASSWORD=motdepasse
SMTP_EXPEDITEUR_NOM=Ma Bibliothèque Manga
SMTP_TIMEOUT=5

# --- Tâche planifiée (purger.php), en heures -------------------------------------
# CRON_HEURES : l'espacement réglé chez OVH (1 à 168)
# RAPPORT_HEURES : tous les combien d'heures le rapport détaillé part
# 168 = une semaine, 0 = à chaque passage. Max 720 = 30 jours.
CRON_HEURES=24
RAPPORT_HEURES=168

# --- Secrets -----------------------------------------------------------------------
# Deux longues chaînes aléatoires, différentes l'une de l'autre.
# Changer UPLOAD_SECRET rend les images déjà envoyées introuvables.
CRON_TOKEN=remplacez-moi-par-une-longue-chaine-aleatoire
UPLOAD_SECRET=remplacez-moi-par-une-autre-chaine-aleatoire

# --- Recherche de couverture (MangaDex) --------------------------------------------
# COUVERTURE_MAX_SERIES : nombre de séries proposées. 
# Nombre À 0 ou en commentaire : aucune limite.
# COUVERTURE_CANDIDATS borne le coût réel.
COUVERTURE_TIMEOUT=5
COUVERTURE_MAX_SERIES=9
COUVERTURE_CANDIDATS=9

# Espacement entre appels sortants (ms) et attente maximale dans la
# file. Ils protègent l'adresse IP du SERVEUR, partagée par tous.
COUVERTURE_ESPACEMENT=250
COUVERTURE_FILE_MAX=2000

# Recherches autorisées par compte et par tranche de FENETRE secondes.
COUVERTURE_FENETRE=120
COUVERTURE_QUOTA=30
# COUVERTURE_QUOTA_ILLIMITE=120

# 1 : l'utilisateur doit désactiver le filtre et valider sa majorité.
# 0 : tout contenu sensible est bloqué.
COUVERTURE_CONTENU_ADULTE=1

# NOUVEAUTE_MINUTES : temps min entre deux vérifications d'une série (60 à 10080)
# 1440 : 1 jour, 10080 : 1 semaine
# NOUVEAUTE_MAX_VISITE et NOUVEAUTE_MAX_CRON : max séries vérifiées par passage
# Pour ces deux-là: 0 = SANS LIMITE
# NOUVEAUTE_PUBLICATION_JOURS : jours entre deux lectures de l'état de publication
# d'une série (en cours, en pause, finie, arrêtée), affiché sur la couverture (1 à 90)
NOUVEAUTE_MINUTES=60
NOUVEAUTE_MAX_VISITE=0
NOUVEAUTE_MAX_CRON=0
NOUVEAUTE_PUBLICATION_JOURS=7

# --- Notifications push ------------------------------------------------------------
# VAPID : générer avec php outils/vapid.php
# Vides : pas de notifications
# Les appareils notifiés par compte suivent MAX_APPAREILS (plus haut).
# PUSH_TTL : temps qu'un message non remis est gardé (60s à 2419200s)
# PUSH_TIMEOUT : délai d'un envoi, en secondes (1 à 20)
VAPID_PUBLIC=
VAPID_PRIVATE=
PUSH_TTL=86400
PUSH_TIMEOUT=5

# --- Images ------------------------------------------------------------------------
# IMAGE_PIXELS_MAX est ramené automatiquement sous ce que memory_limit
# permet : une image tient environ 4 octets par pixel en mémoire.
IMAGE_TAILLE_MAX=8388608
IMAGE_COTE_MAX=600
IMAGE_QUALITE=82
IMAGE_PIXELS_MAX=12000000
IMPORT_TAILLE_MAX=5242880
TOME_MAX=9999

# --- Mentions légales -------------------------------------------------------------
# LEGAL_EDITEUR : nom et prénom, obligatoire même pour un particulier.
# LEGAL_CONTACT : vide = ADMIN_EMAIL est utilisé.
# LEGAL_ADRESSE : facultative pour un particulier non professionnel.
LEGAL_EDITEUR=
LEGAL_STATUT=Particulier
LEGAL_CONTACT=
LEGAL_ADRESSE=
LEGAL_HEBERGEUR=OVH SAS
LEGAL_HEBERGEUR_ADRESSE=2 rue Kellermann, 59100 Roubaix, France
LEGAL_HEBERGEUR_TEL=1007
LEGAL_HEBERGEUR_PAYS=France


# --- Freins anti-force-brute -------------------------------------------------------
# Partout : _MAX = tentatives tolérées, _BLOCAGE = secondes.
# Le blocage double à chaque récidive, jusqu'à LIMITEUR_BLOCAGE_MAX.
LIMITEUR_FENETRE=900
LIMITEUR_BLOCAGE_MAX=3600
LIMITEUR_OUBLI=86400

CONNEXION_MAX_ESSAIS=5
CONNEXION_BLOCAGE=60

CONNEXION_MAX_ESSAIS_COMPTE=12
CONNEXION_BLOCAGE_COMPTE=120

INSCRIPTION_MAX=5
INSCRIPTION_BLOCAGE=600

MDP_OUBLIE_MAX=3
MDP_OUBLIE_BLOCAGE=900

VERIF_RENVOI_MAX=3
VERIF_RENVOI_BLOCAGE=600

MDP_CONFIRM_MAX=5
MDP_CONFIRM_BLOCAGE=60

# --- Adresse IP des visiteurs ------------------------------------------------------
# Identification du client. Vide = REMOTE_ADDR. A passer a
# X-Forwarded-For si la verification en production montre que PHP voit
# l'adresse du repartiteur OVH et non celle du visiteur.
IP_ENTETE=
IP_PROXY_SAUTS=1
