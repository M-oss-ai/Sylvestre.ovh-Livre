# =====================================================================
# Exemple de configuration — copiez ce fichier en « .env » puis
# remplacez les valeurs. « .env » n'est jamais versionné (.gitignore).
#
# En production, placez le .env AU-DESSUS de www/ : il reste alors hors
# de portée du serveur web même si un .htaccess venait à être ignoré.
# =====================================================================

# --- Identité du site -------------------------------------------------

# Adresse publique, SANS barre oblique finale. Elle sert à fabriquer les
# liens des e-mails et ne doit JAMAIS être déduite de la requête :
# l'en-tête Host est choisi par le client, et un attaquant pourrait faire
# pointer vos liens de réinitialisation vers son propre serveur.
#   Local : http://localhost/Livre     OVH : https://votredomaine.fr
APP_URL=https://votredomaine.fr

# Adresse affichée aux utilisateurs quand une limite est atteinte.
ADMIN_EMAIL=admin@exemple.com

# --- Base de données --------------------------------------------------

DB_HOST=localhost
DB_NAME=Livre
DB_USER=root
DB_PASSWORD=motdepasse

# --- Envoi d'e-mails (obligatoire) ------------------------------------
# Sans SMTP fonctionnel, personne ne peut créer de compte : l'adresse
# doit être confirmée avant la première connexion.
# Boîte OVH : manager.ovh.com > votre domaine > Emails. SMTP_USER est
# l'adresse complète de la boîte, SMTP_PASSWORD son mot de passe.
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=587
SMTP_USER=noreply@exemple.com
SMTP_PASSWORD=motdepasse
SMTP_EXPEDITEUR_NOM=Ma Bibliothèque Manga

# Aucun plafond d'envoi applicatif : le seul frein est le limiteur par IP
# des pages qui déclenchent un e-mail. La limite d'envoi journalière de
# votre boîte OVH est donc la seule borne réelle — une fois atteinte,
# plus aucun e-mail ne part, donc plus aucune inscription ni
# réinitialisation. Surveillez le journal d'erreurs de l'hébergement.

# --- Secrets ----------------------------------------------------------

# Jeton exigé par purger.php en HTTP (en-tête X-Cron-Token).
# Vide = l'appel HTTP est refusé ; l'appel en ligne de commande reste
# possible. Générez une longue chaîne aléatoire.
CRON_TOKEN=remplacez-moi-par-une-longue-chaine-aleatoire

# Sel des noms de fichiers envoyés. Sans lui, le nom d'une image se
# devine à partir de l'image elle-même : on peut alors vérifier qu'un
# utilisateur du site possède telle image. Générez une chaîne aléatoire.
# À ne plus changer une fois le site en service (les images déjà
# présentes garderaient leur ancien nom).
UPLOAD_SECRET=remplacez-moi-par-une-autre-chaine-aleatoire

# --- Quotas de l'application ------------------------------------------

MAX_UTILISATEURS=100
MAX_SERIES_PAR_UTILISATEUR=150

# Appareils mémorisés (« se souvenir de moi ») par compte illimité.
# Au-delà, le plus ancien jeton est supprimé.
MAX_APPAREILS=30

# --- Identification du client (IMPORTANT en production) ---------------
#
# Tout le limiteur anti force brute compte « par IP », et le journal de
# sécurité note d'où vient chaque évènement.
#
# Chez OVH le site est derrière un répartiteur de charge. Selon
# l'infrastructure, PHP voit soit l'adresse du visiteur, soit celle du
# répartiteur — et dans ce second cas TOUS les visiteurs partagent un
# seul compteur : cinq mauvais mots de passe bloquent alors la connexion
# pour tout le site, et le journal ne sert plus à rien.
#
# VÉRIFIEZ-LE une fois en ligne (voir README), puis :
#   vide            = PHP voit la bonne adresse (valeur par défaut)
#   X-Forwarded-For = PHP voit le répartiteur, il faut lire l'en-tête
#
# ⚠️ Ne renseignez ceci QUE si le site est réellement inaccessible
# autrement qu'à travers le proxy. Sans proxy devant, n'importe qui
# enverrait l'en-tête de son choix et deviendrait un nouveau visiteur à
# chaque requête : le limiteur ne verrait plus jamais deux tentatives
# venir du même endroit.
IP_ENTETE=

# Nombre de relais de confiance devant le site. 1 = un répartiteur (cas
# OVH habituel) ; 2 = un CDN devant le répartiteur. L'en-tête est lu en
# partant de la droite : les entrées de gauche viennent du client et sont
# librement inventées.
IP_PROXY_SAUTS=1

# --- Anti force brute -------------------------------------------------
#
# Toutes les durées sont en secondes. Chaque valeur a un plancher codé
# en dur : une faute de frappe ne peut pas désarmer la protection.
#
# Principe : au-delà de MAX essais dans la FENÊTRE, l'action est bloquée
# pendant la durée indiquée — durée qui DOUBLE à chaque récidive,
# jusqu'à LIMITEUR_BLOCAGE_MAX.

# Fenêtre de comptage : un échec plus ancien ne compte plus.
# Elle doit rester nettement PLUS LONGUE que les durées de blocage
# ci-dessous : quand les deux se confondent, il suffit d'espacer ses
# tentatives pour n'être jamais bloqué.
LIMITEUR_FENETRE=900

# Plafond de la durée de blocage, quel que soit le nombre de récidives.
LIMITEUR_BLOCAGE_MAX=3600

# Sans nouvelle tentative pendant ce délai, le compteur de récidives
# (donc le doublement) repart à zéro.
LIMITEUR_OUBLI=86400

# Connexion, par adresse IP.
CONNEXION_MAX_ESSAIS=5
CONNEXION_BLOCAGE=60

# Connexion, par COMPTE : c'est ce qui arrête une attaque distribuée,
# qu'un compteur par IP ne voit pas (une tentative par machine, mille
# machines). Volontairement plus tolérant, car qui connaît un
# identifiant peut sinon verrouiller le compte de son titulaire à
# volonté. Montez-le si vos utilisateurs se plaignent d'être bloqués.
CONNEXION_MAX_ESSAIS_COMPTE=12
CONNEXION_BLOCAGE_COMPTE=120

# Créations de compte, par IP.
INSCRIPTION_MAX=5
INSCRIPTION_BLOCAGE=600

# Demandes de « mot de passe oublié », par IP. Avec la disparition des
# quotas d'envoi, c'est le SEUL frein sur ces e-mails : ne le desserrez
# pas à la légère.
MDP_OUBLIE_MAX=3
MDP_OUBLIE_BLOCAGE=900

# Renvois du lien de confirmation d'adresse, par IP. Même remarque.
VERIF_RENVOI_MAX=3
VERIF_RENVOI_BLOCAGE=600

# Confirmation par mot de passe des actions sensibles (changement
# d'adresse, vidage de la bibliothèque, suppression du compte). Sans
# limite, une session volée permet de deviner le mot de passe sans
# laisser de trace, et chaque essai coûte un password_verify() lent.
MDP_CONFIRM_MAX=5
MDP_CONFIRM_BLOCAGE=60

# --- Politique de mot de passe ----------------------------------------
#
# Seule la longueur se règle ici. Les classes exigées (majuscule,
# minuscule, chiffre, caractère spécial) restent dans le code.
# MDP_MIN ne peut pas descendre sous 8, quoi qu'on écrive ici.
# Le texte d'aide affiché aux utilisateurs suit automatiquement.
MDP_MIN=8
MDP_MAX=200

# --- Images envoyées --------------------------------------------------

# Taille du fichier reçu, en octets (3145728 = 3 Mo).
# Doit rester SOUS upload_max_filesize et post_max_size du .user.ini :
# au-delà, PHP refuse la requête avant que l'application ne s'exprime.
IMAGE_TAILLE_MAX=3145728

# Plus grand côté de l'image stockée, en pixels. Les cartes font 210 à
# 280 px de large : 600 reste net sur un écran Retina.
IMAGE_COTE_MAX=600

# Qualité de ré-encodage WebP/JPEG, de 1 à 100.
IMAGE_QUALITE=82

# Refus de décompresser au-delà de ce nombre de pixels (« bombe de
# décompression » : un fichier de 200 Ko peut décrire du 20 000 × 20 000).
#
# GD alloue ~4 OCTETS PAR PIXEL. Cette valeur est donc automatiquement
# ramenée à ce que le memory_limit du .user.ini permet réellement — un
# chiffre trop généreux ici ne peut plus tuer le processus PHP, il est
# simplement ignoré au profit du maximum sûr.
#     12 Mpx ~ 48 Mo  ·  20 Mpx ~ 80 Mo  ·  40 Mpx ~ 160 Mo
# 12 Mpx laissent passer toute photo de téléphone en résolution standard.
IMAGE_PIXELS_MAX=12000000

# --- Import / divers --------------------------------------------------

# Taille maximale d'un fichier de sauvegarde à l'import, en octets.
IMPORT_TAILLE_MAX=5242880

# Borne haute du numéro de tome.
TOME_MAX=9999

# Délai accordé au serveur SMTP, en secondes. L'envoi immobilise un
# processus PHP et un mutualisé n'en a qu'une poignée : au-delà de
# quelques secondes, des inscriptions simultanées figent le site. Un
# envoi trop lent n'est pas perdu, il part en file de rattrapage.
SMTP_TIMEOUT=5

# Nombre d'échecs après lequel un message en file est abandonné.
MAIL_FILE_MAX_ESSAIS=3

# --- Sessions ---------------------------------------------------------

# Durée du cookie de session, en secondes (0 = fermeture du navigateur).
SESSION_DUREE=0

# Forfait illimité : durée du jeton par appareil (défaut 1 an).
REMEMBER_DUREE_VIP=31536000

# --- Ressources statiques ---------------------------------------------

# Version ajoutée aux URL de css/ et js/ (?v=...).
# À INCRÉMENTER À CHAQUE DÉPLOIEMENT : le .htaccess demande aux
# navigateurs de garder ces fichiers un an, donc sans changement d'URL
# une correction ne parvient jamais à ceux qui ont déjà visité le site.
# Laissé VIDE en développement : on retombe sur la date de modification
# des fichiers, plus pratique pour coder mais coûteux sur le disque
# réseau d'un hébergement mutualisé.
ASSETS_VERSION=1

# --- Informations légales (affichées par mentions-legales.php) --------
#
# Droit SUISSE (nLPD). Contrairement à la France, aucune obligation
# générale de « mentions légales » pour un site gratuit et non
# commercial. Seuls DEUX champs sont juridiquement exigés, au titre du
# devoir d'informer de l'art. 19 nLPD :
#
#   LEGAL_EDITEUR  — votre nom réel (un pseudonyme ne satisfait pas
#                    l'exigence d'« identité » du responsable du traitement)
#   LEGAL_CONTACT  — une adresse qui fonctionne et que vous relevez.
#                    Un alias convient parfaitement, et évite d'exposer
#                    votre adresse principale. Vide = ADMIN_EMAIL.
#
# Tous les autres champs sont facultatifs : laissés vides, leur ligne
# disparaît simplement de la page.

LEGAL_EDITEUR=
# « Particulier », « Association », « Sàrl »… Affirme le caractère non
# commercial du site, ce qui écarte l'art. 3 al. 1 let. s LCD.
LEGAL_STATUT=Particulier
LEGAL_CONTACT=
# Adresse postale : NON exigée pour un site gratuit non commercial.
# Elle ne le deviendrait que si vous vendiez quelque chose.
LEGAL_ADRESSE=

# Hébergeur — non obligatoire en Suisse (c'est une exigence française),
# mais transparent et utile.
LEGAL_HEBERGEUR=OVH SAS
LEGAL_HEBERGEUR_ADRESSE=2 rue Kellermann, 59100 Roubaix, France
LEGAL_HEBERGEUR_TEL=1007

# Pays où les données sont PHYSIQUEMENT stockées. Celui-ci est bel et
# bien obligatoire : l'art. 19 al. 4 nLPD impose d'indiquer l'État vers
# lequel les données sont communiquées. Champ distinct de l'adresse
# ci-dessus, qui n'est qu'une adresse postale.
#
# ⚠️ Si vous changez d'hébergeur, vérifiez que le nouveau pays figure
# toujours sur la liste des États à protection adéquate (annexe 1 OPDo).
# Sinon le transfert exige des garanties supplémentaires, et la page
# mentions-legales.php affirmera quelque chose de faux.
LEGAL_HEBERGEUR_PAYS=France
