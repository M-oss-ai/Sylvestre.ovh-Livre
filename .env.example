# =====================================================================
# Copiez ce fichier en « .env » et remplacez les valeurs.
# « .env » n'est jamais versionné (.gitignore).
#
# En production, placez-le AU-DESSUS de www/ : il reste alors hors de
# portée du serveur web même si un .htaccess venait à être ignoré.
#
# Tout est expliqué en détail dans le README. Ici, seulement ce qui
# coûte cher si on se trompe.
# =====================================================================

# --- Site -------------------------------------------------------------
# E-mail admin affiché aux utilisateurs
# APP_URL : sans barre oblique finale. Elle fabrique les liens des e-mails
APP_URL=https://votredomaine.fr
ADMIN_EMAIL=admin@exemple.com

# --- Connextion Base de Données --------------------------------------------------
DB_HOST=localhost
DB_NAME=Livre
DB_USER=root
DB_PASSWORD=motdepasse

# --- Cache des fichiers js/ et css/ ------------------------------------
# À INCRÉMENTER à chaque déploiement qui touche js/ ou css/.
ASSETS_VERSION=1

# --- Quotas -----------------------------------------------------------
MAX_UTILISATEURS=100
MAX_SERIES_PAR_UTILISATEUR=150
MAX_APPAREILS=30
QUOTA_BASE_MO=200

# --- Sessions ---------------------------------------------------------
# Durée à « 0 » : le cookie de session meurt avec le navigateur.
# Durée à « 31536000 » : le cookie de session dure 1 an.
SESSION_DUREE=0
REMEMBER_DUREE_VIP=31536000

# --- Mots de passe ----------------------------------------------------
MDP_MIN=8
MDP_MAX=200

# --- E-mails SMTP --------------------------------------------------------
# Boîte OVH : manager.ovh.com > votre domaine > Emails.
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=587
SMTP_USER=noreply@exemple.com
SMTP_PASSWORD=motdepasse
SMTP_EXPEDITEUR_NOM=Ma Bibliothèque Manga
SMTP_TIMEOUT=5
MAIL_FILE_MAX_ESSAIS=3

# --- Tâche planifiée (purger.php), en heures ---------------------------
# CRON_HEURES : l'espacement réglé chez OVH (24 = chaque jour, conseillé :
# c'est aussi lui qui renvoie les e-mails bloqués).
# RAPPORT_HEURES : tous les combien d'heures le rapport détaillé part
# (168 = chaque semaine). 0 = à chaque passage. Max 720 (30 jours).
# Une anomalie part toujours tout de suite.
CRON_HEURES=24
RAPPORT_HEURES=168

# --- Secrets ----------------------------------------------------------
# Deux longues chaînes aléatoires, différentes l'une de l'autre.
# Changer UPLOAD_SECRET rend les images déjà envoyées introuvables.
CRON_TOKEN=remplacez-moi-par-une-longue-chaine-aleatoire
UPLOAD_SECRET=remplacez-moi-par-une-autre-chaine-aleatoire

# --- Recherche de couverture (MangaDex) -------------------------------
# COUVERTURE_MAX_SERIES : nombre de séries proposées. 
# Nombre À 0 ou en commentaire : aucune limite.
# COUVERTURE_CANDIDATS borne le coût réel.
COUVERTURE_TIMEOUT=5
COUVERTURE_MAX_SERIES=15
COUVERTURE_CANDIDATS=15

# Espacement entre appels sortants (ms) et attente maximale dans la
# file. Ils protègent l'adresse IP du SERVEUR, partagée par tous.
COUVERTURE_ESPACEMENT=250
COUVERTURE_FILE_MAX=2000

# Recherches autorisées par compte et par tranche de FENETRE secondes.
COUVERTURE_FENETRE=120
COUVERTURE_QUOTA=30
COUVERTURE_QUOTA_ILLIMITE=120

# 1 : l'utilisateur doit désactiver le filtre et validé sa majorité.
# 2 : tout contenu sensible est block�.
COUVERTURE_CONTENU_ADULTE=1

# --- Images -----------------------------------------------------------
# IMAGE_PIXELS_MAX est ramené automatiquement sous ce que memory_limit
# permet : une image tient environ 4 octets par pixel en mémoire.
IMAGE_TAILLE_MAX=8388608
IMAGE_COTE_MAX=600
IMAGE_QUALITE=82
IMAGE_PIXELS_MAX=12000000
IMPORT_TAILLE_MAX=5242880
TOME_MAX=9999

# --- Mentions légales -------------------------------------------------
# LEGAL_EDITEUR : nom et prénom, obligatoire même pour un particulier.
# LEGAL_CONTACT : vide = ADMIN_EMAIL est utilisé.
# LEGAL_ADRESSE : facultative pour un particulier non professionnel.
LEGAL_EDITEUR=
LEGAL_STATUT=Particulier
LEGAL_CONTACT=
LEGAL_ADRESSE=
LEGAL_HEBERGEUR=OVH SAS
LEGAL_HEBERGEUR_ADRESSE=2 rue Kellermann, 59100 Roubaix, France
LEGAL_HEBERGEUR_TEL=1007
LEGAL_HEBERGEUR_PAYS=France


# --- Freins anti-force-brute ------------------------------------------
# Partout : _MAX = tentatives tolérées, _BLOCAGE = secondes.
# Le blocage double à chaque récidive, jusqu'à LIMITEUR_BLOCAGE_MAX.
LIMITEUR_FENETRE=900
LIMITEUR_BLOCAGE_MAX=3600
LIMITEUR_OUBLI=86400

CONNEXION_MAX_ESSAIS=5
CONNEXION_BLOCAGE=60
CONNEXION_MAX_ESSAIS_COMPTE=12
CONNEXION_BLOCAGE_COMPTE=120

INSCRIPTION_MAX=5
INSCRIPTION_BLOCAGE=600

MDP_OUBLIE_MAX=3
MDP_OUBLIE_BLOCAGE=900

VERIF_RENVOI_MAX=3
VERIF_RENVOI_BLOCAGE=600

MDP_CONFIRM_MAX=5
MDP_CONFIRM_BLOCAGE=60

# --- Adresse IP des visiteurs -----------------------------------------
# Laissez IP_ENTETE VIDE si PHP voit déjà l'adresse publique : sinon
# n'importe qui enverrait l'en-tête de son choix pour passer à travers
# les freins ci-dessous. Dans le doute, appelez purger.php?ip avec le
# jeton du cron : il vous dit quoi mettre.
IP_ENTETE=
IP_PROXY_SAUTS=1
